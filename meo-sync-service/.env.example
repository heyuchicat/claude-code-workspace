# データベース(SQLite。ファイルパスのみでOK。編集不要)
DATABASE_URL="file:./dev.db"

# ログインパスワードやcron用の秘密鍵は .env を編集する必要はありません。
# npm run dev で起動し、ブラウザで初回アクセスした際に表示される
# セットアップ画面から設定してください。

# --- Instagram連携(未設定の場合はダミーデータのデモモードで動作) ---
# Meta for Developers でアプリを作成し、Instagram API with Instagram Login を追加して取得
# https://developers.facebook.com/apps/
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"

# --- Google Business Profile連携(未設定の場合はダミーデータのデモモードで動作) ---
# Google Cloud Console で OAuthクライアントIDを作成して取得
# https://console.cloud.google.com/apis/credentials
# ※ Business Profile APIsの利用にはGoogleへのアクセス申請・承認が別途必要です
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# --- 競合比較機能(未設定の場合は競合比較タブがエラーになります) ---
# Google Cloud Console で「Places API (New)」を有効化し、APIキー方式で取得
# (OAuthとは別物で、Business Profile APIsの承認は不要です)
GOOGLE_MAPS_API_KEY=""

# --- 月次レポートメール・低評価クチコミ/順位低下アラートのメール送信(未設定の場合はメール送信のみ無効化) ---
# 未設定でもSlack通知(店舗設定画面のWebhook URL)は利用できます
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- 検索順位チェック機能(実験的)でPlaywrightのChromiumパスを明示したい場合のみ設定 ---
# 通常は不要です(`npx playwright install chromium` 済みなら自動検出されます)
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""
