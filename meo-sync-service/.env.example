# データベース(SQLite。ファイルパスのみでOK)
DATABASE_URL="file:./dev.db"

# ダッシュボードのログインパスワード(必須)
ADMIN_PASSWORD="change-me"
# セッションcookie署名用のランダム文字列(必須。 openssl rand -hex 32 などで生成)
SESSION_SECRET="change-me"

# --- Instagram連携(未設定の場合はダミーデータのデモモードで動作) ---
# Meta for Developers でアプリを作成し、Instagram API with Instagram Login を追加して取得
# https://developers.facebook.com/apps/
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"

# --- Google Business Profile連携(未設定の場合はダミーデータのデモモードで動作) ---
# Google Cloud Console で OAuthクライアントIDを作成して取得
# https://console.cloud.google.com/apis/credentials
# ※ Business Profile APIsの利用にはGoogleへのアクセス申請・承認が別途必要です
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
